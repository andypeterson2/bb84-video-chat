FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Runtime dependencies only: the test and lint toolchain has no business in a
# deployed image. `npm ci` is strict, so the lockfile is what ships.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY server/ server/

# The server binds a high port from PORT and writes nothing, so it needs no
# privilege. The node image already carries an unprivileged `node` user.
USER node

CMD ["node", "server/main.js"]
