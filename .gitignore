# all hidden directories
.*
!.git*
!.dashboard.yaml
!.dockerignore
!.prettierignore

__pycache__
node_modules

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# OSX
**/.DS_Store

# Project specific exclusions
settings.ini
settings*.ini
**/dev_python_config.json
key.bin

# Local bench configs (ports, seeds, tokens) stay out of version control
bench*.local.toml
bench/*.local.toml

# Playwright e2e artifacts
test-results
playwright-report

# The linter plugin is shared, so its settings file is tracked. Re-including the
# directory is required before the file, then everything else there stays local.
!.claude/
.claude/*
!.claude/settings.json
