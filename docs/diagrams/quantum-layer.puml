@startuml quantum-layer
!include style.puml

title BB84 Quantum Layer — Reservoir Engine + Pluggable Backends

package "browser (per peer)" {
    component [ReservoirEngine] as Engine {
        component [per-frame sift + QBER gate] as Sift
        component [pooled distill\n(parities + verify hash + Toeplitz)] as Distill
        component [rotation\n(floored, 4-key pool)] as Rot
    }
    interface "FrameSource" as FS
    component [LoopbackFrameSource\n(SimulatedQuantumChannel)] as Loop
    component [DaemonFrameSource\n(WebSocket to daemon)] as DaemonSrc
    component [crypto worker\n(AES-128-GCM, 2-key ring)] as Worker
    component [channel-auth\n(HMAC envelopes + SAS)] as Auth
}

package "bench daemon (per peer, optical mode)" {
    interface "drivers.py ABCs\n(THE SWAP LINE)" as Drivers
    component [EmulatedAWG] as AWG
    component [EmulatedTimeTagger] as Tagger
    component [alignment + slot_recovery\n(Qubit4Sync)] as Recover
    component [eve.py\n(intercept-resend tap)] as Eve
}

' Backend selection
FS <|.. Loop
FS <|.. DaemonSrc
Engine --> FS : frames in / detections out

' Simulated path (loopback): detections cross the peers' mux
Loop ..> Loop : detections over mux 'quantum'

' Optical path: quantum crosses the fiber daemon-to-daemon
DaemonSrc --> Drivers : transmit / detections (WebSocket)
Drivers <|-- AWG
Drivers <|-- Tagger
AWG --> Eve : pulse records
Eve --> Tagger : emulated fiber\n(cleartext, loopback-confined)
Tagger --> Recover : clicks (detector clock)
Recover --> DaemonSrc : recovered detections

' Classical reconciliation rides the authenticated DataChannel either way
Sift --> Auth : frame-detections / bases / sample (authenticated)
Distill --> Auth : parities / verify-hash / seed
Rot --> Worker : setEncryptionKey(key, index)

note bottom of Drivers
  Everything ABOVE this line ships to
  the real bench unchanged. Real optics
  = concrete drivers here + fiber off.
  See docs/HARDWARE.md.
end note

note bottom of Engine
  Continuous stream, not rounds:
  • gate each frame at QBER 0.11
  • pool accepted bits
  • mint when pool ≥ key + leakage
  • 3 consecutive failures ⇒ latch
end note

@enduml
